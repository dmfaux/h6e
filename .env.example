# Example environment file. Names only, never real values.
#
# Real values live per environment in the Vercel project (Preview and
# Production) and, for any CI-only need, in GitHub Actions secrets. Nothing in
# this file is a secret and nothing secret is ever committed (requirement B3,
# ADR 0024). Copy to .env.local for local development; .env* is gitignored.

# Session signing secret. Set distinctly per environment in Vercel
# (Preview and Production hold different values). Consumed from Task 0.3
# onward (ADR 0008). Generate with: openssl rand -base64 32
SESSION_SECRET=

# Marks which deployment environment the agent is running in. Set per
# environment in Vercel (preview / production). Used to keep environments
# visibly distinct; not a secret.
APP_ENV=

# Optional. Only needed to route model calls through the Vercel AI Gateway
# from a non-Vercel host. On Vercel the gateway authenticates via project
# OIDC, so this is left unset there. No model calls exist yet in Phase 0.
# AI_GATEWAY_API_KEY=

# Platform-provided, not set by hand. Vercel sets VERCEL_ENV and NODE_ENV
# itself; the dev auth provider refuses to start if either says production.
# VERCEL_OIDC_TOKEN is the project identity Connect exchanges, present on
# Vercel and fetched locally with `vercel env pull`.
# VERCEL_ENV=
# NODE_ENV=
# VERCEL_OIDC_TOKEN=

# --- Internal auth (ADR 0003, ADR 0008) ---

# Which provider sits behind the auth interface: "dev" (default) or "entra".
AUTH_PROVIDER=

# Dev provider users as a JSON array of { id, email, username, password, roles }.
# Holds passwords, so treat as a secret. Never used in production.
DEV_AUTH_USERS=

# Optional session lifetime in seconds. Defaults to 3600 (one hour) when unset.
SESSION_TTL_SECONDS=

# --- WhatsApp candidate channel (ADR 0026) ---

# Meta app secret used to verify the X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=

# Token Meta echoes back in the webhook verify handshake. Chosen by us per environment.
WHATSAPP_VERIFY_TOKEN=

# Cloud API phone number id that outbound acknowledgements are sent from.
WHATSAPP_PHONE_NUMBER_ID=

# Cloud API access token for outbound sends. Secret.
WHATSAPP_ACCESS_TOKEN=

# JSON object mapping requisition reference to role title, used to name the
# role in the acknowledgement. Unset or malformed resolves no role.
WHATSAPP_ROLE_CATALOG=

# --- Connect scoped-credential broker (ADR 0009) ---

# Vercel Connect connector id for Microsoft 365 (calendar and documents).
M365_CONNECT_CONNECTOR=

# Vercel Connect connector id for the ATS (read-only logistics fields).
ATS_CONNECT_CONNECTOR=

# Mailbox whose free/busy the live broker proof reads (src/connect/proof.ts).
M365_SCHEDULE_ADDRESS=

# Optional actor name written to the broker audit records by the live proof.
CONNECT_ACTOR=
